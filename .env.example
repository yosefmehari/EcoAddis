# Environment variables template for EcoAddis
# Copy this file to .env and fill in your actual values.

# Database URL: PostgreSQL (e.g. from Neon.tech with connection pooling)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/ecoaddis?sslmode=require&pgbouncer=true"

# Direct URL for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/ecoaddis?sslmode=require"

# JWT Secret for session authentication (generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
